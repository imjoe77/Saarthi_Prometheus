# ---------------------------------------------------------------------------
# Sepolia deployment configuration template (blockchain/)
# Copy to `.env` (git-ignored by the root `.env*` rule) and fill in.
#
# RULES
#  - NEVER put a private key, seed phrase, or API secret in this file or any
#    file inside the repository. Keys are referenced by PATH only and live
#    outside the repository (default: ~/.prometheus/sepolia/).
#  - NEVER commit `.env`.
#  - There is no mainnet network in hardhat.config.ts - only the in-process
#    hardhat chain, localhost:8545, and sepolia (chain id 11155111).
# ---------------------------------------------------------------------------

# RPC endpoint. The public node below works with no credential; use an
# Alchemy/Infura endpoint if you hit rate limits.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Path to the deployer's 0x-hex key file OUTSIDE the repository.
# Generate the account set with the steps in scripts/SEPOLIA.md, or point this
# at your own funded Sepolia account's key file.
SEPOLIA_DEPLOYER_KEY_FILE=

# Role addresses (public). The backend and contract treat the treasury as the
# only mint destination and the only burn source.
TREASURY_ADDRESS=
MINTER_ADDRESS=
# BURNER_ADDRESS=            # optional; defaults to TREASURY_ADDRESS

# Lifetime economics recorded at deployment (whole EMBER, cap enforced by the
# contract). Match your local values unless the owner decided otherwise.
MAX_SUPPLY_EMBER=100000000
INITIAL_TREASURY_ALLOCATION_EMBER=10000000
