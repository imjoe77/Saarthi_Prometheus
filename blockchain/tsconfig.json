{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "dist"
  },
  "include": ["./scripts/**/*.ts", "./test/**/*.ts", "./hardhat.config.ts"],
  "files": ["./hardhat.config.ts"]
}
