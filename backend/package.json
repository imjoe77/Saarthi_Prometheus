{
  "name": "prometheus-backend",
  "version": "0.1.0",
  "description": "Prometheus backend - NestJS modular monolith",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.config.js",
    "test:db": "jest --config ./test/jest-e2e.config.js --testPathPatterns=database",
    "test:schema": "jest --config ./test/jest-e2e.config.js --testPathPatterns=schema",
    "test:auth": "jest --config ./test/jest-e2e.config.js --testPathPatterns=auth",
    "test:wallet": "jest --config ./test/jest-e2e.config.js --testPathPatterns=wallet",
    "test:payments": "jest --config ./test/jest-e2e.config.js --testPathPatterns=payments",
    "test:portfolio": "jest --config ./test/jest-e2e.config.js --testPathPatterns=portfolio",
    "test:strategy": "jest --config ./test/jest-e2e.config.js --testPathPatterns=strategy",
    "test:risk": "jest --config ./test/jest-e2e.config.js --testPathPatterns=risk",
    "test:market": "jest --config ./test/jest-e2e.config.js --testPathPatterns=market",
    "test:simulation": "jest --config ./test/jest-e2e.config.js --testPathPatterns=simulation",
    "test:usdt": "jest --config ./test/jest-e2e.config.js --testPathPatterns=usdt",
    "test:liquidity": "jest --config ./test/jest-e2e.config.js --testPathPatterns=liquidity",
    "test:tokenomics": "jest --config ./test/jest-e2e.config.js --testPathPatterns=tokenomics",
    "test:treasury": "jest --config ./test/jest-e2e.config.js --testPathPatterns=treasury",
    "market:seed": "ts-node prisma/market-seed.ts",
    "market:verify": "ts-node prisma/market-seed.ts --dry-run",
    "seed:liquidity": "ts-node prisma/seed-liquidity.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:status": "prisma migrate status",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "grant:role": "ts-node prisma/grant-role.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@prisma/client": "^6.15.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "joi": "^18.0.1",
    "jose": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "prisma": "^6.15.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
