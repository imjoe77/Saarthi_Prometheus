# ---------------------------------------------------------------------------
# Prometheus backend - environment configuration
# Copy to .env and adjust. NEVER commit .env.
# Every variable below is validated at boot by src/config/env.validation.ts.
# The app refuses to start with an invalid or incomplete configuration.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development

# HTTP server
PORT=3001
HOST=0.0.0.0
# Global route prefix, e.g. /api -> health lives at http://localhost:3001/api/health
API_PREFIX=api

# Comma-separated list of browser origins allowed to call the API.
# Use exact origins. No wildcard.
CORS_ORIGINS=http://localhost:3000

# Logging: error | warn | log | debug | verbose
LOG_LEVEL=log

# Swagger/OpenAPI docs. Disable in production if you do not want docs public.
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# Database (PostgreSQL - Prisma)
# ---------------------------------------------------------------------------
# Must match the credentials of the database you actually start. The values
# below are the defaults baked into docker-compose.yml.
#
# Local Docker:
DATABASE_URL=postgresql://prometheus:prometheus_dev_password@localhost:5432/prometheus?schema=public

# Supabase hosted alternative (swap in when you have a project):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=public&sslmode=require

# Connection pool sizing for the Prisma client. Appended to DATABASE_URL as
# Prisma's `connection_limit`, unless the URL already specifies one (required
# by Supabase's transaction-mode pooler, which needs connection_limit=1).
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000

# Startup policy when the database is unreachable.
#   false (default) - start anyway; GET /health reports the database as down.
#   true             - refuse to boot. Appropriate for a strict deployment.
# Liveness should not depend on a dependency, so leave this false locally.
DATABASE_FAIL_FAST=false

# ---------------------------------------------------------------------------
# Authentication (MODULE 02)
# ---------------------------------------------------------------------------
# The backend VERIFIES tokens. It never mints them and never speaks OAuth, so it
# holds no OAuth client credentials and no signing private key - only the public
# key of the pair held by the Next.js app.
#
# Generate the pair with, from the repository root:
#   node scripts/generate-auth-keys.mjs --write --yes
#
# RS256 public key (SPKI PEM) that verifies access tokens. One-line escaped.
# Boot fails if this is absent, unparseable, not RSA, or a private key.
AUTH_API_SIGNING_PUBLIC_KEY=

# Required value of the access token `iss` claim. Must equal the frontend's
# AUTH_API_ISSUER, or every request is refused.
AUTH_API_ISSUER=prometheus-web

# Required value of the access token `aud` claim. Must equal the frontend's
# AUTH_API_AUDIENCE.
AUTH_API_AUDIENCE=prometheus-api

# Access token lifetime, in seconds. Informational here: expiry is enforced by
# the `exp` claim the signer sets, and the backend imposes no clock-skew leeway,
# so shortening this is safe and lengthening it silently widens the window in
# which a leaked token still works.
AUTH_API_TOKEN_TTL_SECONDS=900
# ---------------------------------------------------------------------------
# Wallet top-ups (Module 03b)
# ---------------------------------------------------------------------------
# A top-up is the ONE way money enters a Prometheus wallet. Either way it ends
# in a real `transactions` row of type DEPOSIT, so the INR the user sees is the
# ledger's own number and can be spent on the USDT exchange, the EMBER hub and
# the staking book.
#
# Payment rail:
#   "simulated" (default) - no external provider is involved. The PAYMENT is
#     simulated; the CREDIT is not. The balance and the ledger row are exactly
#     what a real payment would produce.
#   "razorpay"          - the deposit starts PENDING, Razorpay's checkout sheet
#     is opened in the browser, and the money is credited only once Razorpay
#     confirms it (checkout signature or the `payment.captured` webhook).
#
# Switching rails needs no application change: set the provider, drop the keys
# in, restart. Both rails end in the same credit.
PAYMENTS_PROVIDER=simulated

# Razorpay credentials. Required only when PAYMENTS_PROVIDER=razorpay; boot
# refuses to start if the rail is razorpay and either key is missing.
#
# The key id is PUBLISHABLE: Razorpay's checkout script runs in the browser and
# needs it, so the API hands it to the browser. The key secret is not - it
# signs the checkout signature and authorises the Orders API, and it never
# leaves the backend.
#
# Use Razorpay TEST keys (rzp_test_...) while developing.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Secret Razorpay signs inbound webhooks with, sent as the
# X-Razorpay-Signature header. Without it every webhook delivery is refused,
# so a Razorpay rail with no webhook secret can only be confirmed by the
# browser returning from checkout.
# RAZORPAY_WEBHOOK_SECRET=

# Largest single top-up accepted, in INR. An abuse rail on one request, not a
# cap on what a wallet may hold.
# PAYMENTS_MAX_DEPOSIT_INR=500000

# Timeout for each outbound payment-provider HTTP call (1000-30000 ms).
# PAYMENTS_REQUEST_TIMEOUT_MS=10000
# ---------------------------------------------------------------------------
# Live USDT/INR pricing (Module 08 extension)
# ---------------------------------------------------------------------------
# Pricing source: "live" (CoinDCX order book + CoinGecko reference) or "fake"
# (deterministic provider for tests; the default under NODE_ENV=test).
# USDT_PRICING_PROVIDER=live

# CoinGecko demo API key, sent as the x-cg-demo-api-key header. Optional -
# the public endpoints work without it at a lower rate limit. Backend-only:
# never expose it to the browser or log it.
COIN_GECKO_API=

# Provider base URLs (override only for tests or a proxy).
# COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# COINDCX_TICKER_URL=https://api.coindcx.com/exchange/ticker
# COINDCX_ORDERBOOK_URL=https://public.coindcx.com/market_data/orderbook

# Display-only indicative USDT/INR price used when live pricing is
# unreachable. Quotes served from it are labelled "fallback" and carry no
# savings figure; buy/sell NEVER execute at this price. It is a configured
# value, not a market observation - review it periodically against the real
# market (verified 2026-10-14: CoinDCX USDTINR ~99.90).
USDT_FALLBACK_PRICE_INR=99.90

# Freshness and validation windows (millisecond/percent).
# USDT_PRICE_MAX_AGE_MS=30000        # max age of the CoinDCX execution price
# USDT_REFERENCE_MAX_AGE_MS=900000   # max age of CoinGecko reference data
# USDT_FETCH_TIMEOUT_MS=3000         # per-call provider timeout
# USDT_PRICE_CACHE_TTL_MS=5000       # in-memory snapshot cache TTL
# USDT_PRICE_SANITY_MAX_DEV_PCT=20   # max execution-vs-aggregate deviation

# Test-only behaviour of the fake provider: live | stale | down | no-reference.
# USDT_FAKE_PRICING_SCENARIO=live
# ---------------------------------------------------------------------------
# Liquidity & order processing (Module 09)
# ---------------------------------------------------------------------------
# Aggregate available USDT at or below which the system reports a shortfall
# and opens a top-up request. Detection only; it never moves funds.
# LIQUIDITY_MIN_AVAILABLE_USDT=200000

# EMBER-locking slabs for LP commitments. A commitment at or above a slab's
# minUsdt (below the next slab) requires a FLAT lock of requiredEmber.
#
# APPROVED 2026-10-18. Leave unset (empty) only to disable commitments: every
# create/increase/reduction then answers 503 (liquidity_ember_slabs_not_configured)
# and no EMBER can be locked. The zero-floor slab means any positive pledge
# qualifies. These exact values are also what the e2e suites exercise via the
# labelled TEST fixture in test/liquidity-test-fixture.ts.
LIQUIDITY_EMBER_SLABS=[{"minUsdt":"0","requiredEmber":"1000"},{"minUsdt":"100000","requiredEmber":"20000"},{"minUsdt":"250000","requiredEmber":"45000"},{"minUsdt":"500000","requiredEmber":"80000"}]

# ---------------------------------------------------------------------------
# EMBER tokenomics (Module 11)
# ---------------------------------------------------------------------------
# Allocation split for every reference amount: the direct-burn share and the
# simulated-buyback share. Integers, MUST sum to 100 - the backend refuses to
# boot otherwise (an allocation rule that does not cover the whole reference
# amount would silently lose value). Defaults are the approved 60/40.
TOKENOMICS_DIRECT_BURN_PCT=60
TOKENOMICS_BUYBACK_PCT=40

# ---------------------------------------------------------------------------
# Treasury guardrails (Module 12)
# ---------------------------------------------------------------------------
# Approved demo monthly capacity for the platform treasury, in INR. UNSET
# means the approved default 300000000 (Rs 30 crore) applies. GET
# /api/treasury/summary converts it to a USDT display ceiling at
# USDT_FALLBACK_PRICE_INR (the display-only rate) and tracks utilization from
# treasury USDT outflow legs as reporting-only - it never claims spending is
# blocked, because no treasury USDT spending operation enforces the capacity.
# TREASURY_MONTHLY_CAPACITY_INR=300000000

# ---------------------------------------------------------------------------
# Blockchain layer (EMBER token)
# ---------------------------------------------------------------------------
# DISABLED by default: the backend boots with the chain off, off-chain
# tokenomics keeps working, and the blockchain endpoints answer 503
# BLOCKCHAIN_DISABLED. Enable only after deploying from blockchain/ (npm run
# deploy scripts write blockchain/deployments/<network>.json whose
# backendEnv block carries these values) and pointing BLOCKCHAIN_RPC_URL at a
# reachable node.
#
# BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NETWORK=local
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_TOKEN_ADDRESS=
BLOCKCHAIN_TREASURY_ADDRESS=
BLOCKCHAIN_EMBER_MAX_SUPPLY=100000000
BLOCKCHAIN_DEPLOYMENT_BLOCK=0
BLOCKCHAIN_CONFIRMATIONS=1
BLOCKCHAIN_RECEIPT_TIMEOUT_MS=60000
# Server-side only. Never set a private key here for anything beyond the
# deterministic hardhat local accounts. For testnet use a key file outside
# the repository instead:
# BLOCKCHAIN_SIGNER_KEY_FILE=C:\keys\prometheus-minter.key
# Sepolia (opt-in, never loaded automatically): see .env.sepolia and
# scripts/start-api-sepolia.ps1 - they inject BLOCKCHAIN_* into the process
# environment after verifying chain id 11155111, bytecode, and signer keys.
# This file stays local-mode; nothing switches networks silently.
# Owner-pending mint policy limits (unset disables each check):
# EMBER_MINT_MAX_AMOUNT=250000
# EMBER_MINT_MONTHLY_LIMIT=1000000

# ---------------------------------------------------------------------------
# Dynamic (adaptive) burn policy - OWNER-PENDING DEFAULTS
# ---------------------------------------------------------------------------
# The approved baseline 60/40 is preserved and the policy never crosses the
# fixed 30% reserve floor (the burn guard stays the hard stop). While
# treasury reserve health (available / qualifying funding) is at or above
# TOKENOMICS_ADAPTIVE_HEALTH_UPPER_PCT the baseline split applies exactly;
# below it the direct-burn share ramps down linearly, reaching
# TOKENOMICS_ADAPTIVE_MIN_BURN_PCT at TOKENOMICS_ADAPTIVE_HEALTH_LOWER_PCT
# (which must stay strictly above 30).
TOKENOMICS_ADAPTIVE_SPLIT=true
TOKENOMICS_ADAPTIVE_HEALTH_UPPER_PCT=45
TOKENOMICS_ADAPTIVE_HEALTH_LOWER_PCT=31
TOKENOMICS_ADAPTIVE_MIN_BURN_PCT=40

# ---------------------------------------------------------------------------
# EMBER Hub distribution
# ---------------------------------------------------------------------------
# Configured baseline distribution price (INR per EMBER) and per-user
# rolling limits in EMBER. Purchases are funded with USDT at the central
# USDT_FALLBACK_PRICE_INR rate and are labelled as configured, not market.
# Price and limit values are OWNER-PENDING defaults.
EMBER_HUB_BASELINE_PRICE_INR=2.45
EMBER_HUB_DAILY_EMBER_LIMIT=10000
EMBER_HUB_MONTHLY_EMBER_LIMIT=100000

# ---------------------------------------------------------------------------
# Simulated EMBER staking (simulation-only rewards; nothing is minted)
# ---------------------------------------------------------------------------
EMBER_STAKING_APR_PERCENT=8.4
EMBER_STAKING_LOCK_DAYS=30

# ---------------------------------------------------------------------------
# Sentinel: price monitoring and automated voice alerts (Module 14)
# ---------------------------------------------------------------------------
# Voice-call source: "off" (default - never dials; a triggered alert records a
# call job that fails honestly with VOICE_PROVIDER_DISABLED), "fake" (the
# deterministic provider for development and tests), or "twilio" (real
# telephony, only when explicitly configured - selecting it without all three
# credentials below refuses to boot).
#
# TELEPHONY COSTS MONEY and calls are triggered automatically by market
# prices. Enable `twilio` only after understanding the per-call cost, the
# per-user daily budget (SENTINEL_MAX_CALLS_PER_USER_PER_DAY) and the platform
# daily budget (SENTINEL_MAX_CALLS_PLATFORM_PER_DAY) below.
#
# Real calls are NEVER placed by the automated suite: NODE_ENV=test defaults
# the worker off and requires explicitly configured test credentials.
#
# SENTINEL_VOICE_PROVIDER=off
#
# Twilio server-side credentials (never in the browser, never logged). The
# auth token also verifies inbound status-callback signatures.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+14155550123

# The monitor/caller worker. Defaults true, false under NODE_ENV=test (the
# suites drive POST /sentinel/run-once instead).
# SENTINEL_WORKER_ENABLED=true
# SENTINEL_WORKER_INTERVAL_MS=20000

# Abuse rails (verify legally required consent/quiet-hours rules for your
# deployment jurisdiction before raising these).

# SENTINEL_MAX_ACTIVE_ALERTS_PER_USER=20
# SENTINEL_MAX_CALLS_PER_USER_PER_DAY=5
# SENTINEL_MAX_CALLS_PLATFORM_PER_DAY=200
# SENTINEL_CALL_MAX_ATTEMPTS=3
# SENTINEL_CALL_RETRY_MS=60000

# Phone verification codes (display-delivered in prototype; see docs).
# SENTINEL_VERIFICATION_CODE_TTL_MS=600000
# SENTINEL_VERIFICATION_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# RBAC email allowlists (Module 13)
# ---------------------------------------------------------------------------
# Who may sign in as an Expert Trader, Liquidity Provider or Platform Admin.
# Comma-separated email lists read by the backend at request time; a matching
# address has the role granted on first use, any other address is denied that
# role at login (normal-user sign-in is unrestricted). EMPTY (default) = no
# self-authorization; EXPERT/LIQUIDITY grants then happen only through the
# admin queue or the operator CLI, and PLATFORM_ADMIN only through the
# operator CLI (an admin request is never queued for approval).
#
# One Gmail address may hold only ONE privileged role: an account that
# already has a different one is refused with "try a different account".
EXPERT_TRADER_EMAILS=
LIQUIDITY_PROVIDER_EMAILS=
PLATFORM_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# AI trade-buddy (design-integration task)
#
# Optional POST endpoint of a locally trained model that answers the trade-buddy
# widget's { query, elementContext, pageContext, history } with
# { concept, sections: { what, simple, howItWorks, example, remember } }.
#
# Unset (or empty) means the built-in knowledge base answers alone - a valid
# configuration, not a degraded one. When a URL is set and the model errors or
# times out (20s), the endpoint falls back to the knowledge base instead of
# failing the widget's request.
#
# AI_MODEL_URL=
