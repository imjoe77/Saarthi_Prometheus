# ---------------------------------------------------------------------------
# Prometheus frontend — MODULE 02 (Authentication)
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored and must never be
# committed.
#
# NOTHING here may be prefixed `NEXT_PUBLIC_`. That prefix publishes the value
# into the client bundle, which would hand the OAuth client secrets and the token
# signing key to every visitor. Only the base URL of the API is safe to expose,
# and even that stays server-side behind the BFF proxy.
# ---------------------------------------------------------------------------

# --- Google OAuth ---------------------------------------------------------
# From https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth ---------------------------------------------------------
# From https://github.com/settings/developers -> OAuth Apps
# Authorisation callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Auth.js session ------------------------------------------------------
# Public origin of this app. Also what Auth.js uses to build callback URLs.
AUTH_URL=http://localhost:3000

# Encrypts the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating it signs every user out. Keep it secret and out of version control.
AUTH_SECRET=

# --- Access tokens for the NestJS API -------------------------------------
# Where the BFF forwards authenticated requests.
AUTH_API_BASE_URL=http://localhost:3001

# RS256 private key (PKCS#8 PEM) that signs access tokens. The backend holds
# only the matching public key.
#
# Generate a pair with:  node scripts/generate-auth-keys.mjs
# The script writes the values rather than printing them, so a private key does
# not end up in a terminal scrollback, a log file or a screenshot.
AUTH_API_SIGNING_PRIVATE_KEY=

# These three must match the backend's AUTH_API_ISSUER, AUTH_API_AUDIENCE and
# AUTH_API_TOKEN_TTL_SECONDS exactly, or the backend will refuse every token.
AUTH_API_ISSUER=prometheus-web
AUTH_API_AUDIENCE=prometheus-api
AUTH_API_TOKEN_TTL_SECONDS=900