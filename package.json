{
  "name": "prometheus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-guard.mjs && concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "node scripts/wait-for-api.mjs && next dev",
    "dev:api": "npm --prefix backend run dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test lib/sentinel-speech.test.ts lib/sentinel-ringtone.test.ts"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "jose": "^6.2.12",
    "lenis": "^1.3.27",
    "lightweight-charts": "^5.0.8",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
